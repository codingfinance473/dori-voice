   "dtype": "auto"
  },
  {
   "id": "t09",
   "mode": "clone",
   "model": "Qwen/Qwen3-TTS-12Hz-0.6B-Base",
   "voice": "voices/dori",
   "seed": 618,
   "takes": 4,
   "texts": [
    "건강, 음주운전, 그리고 임신 중 음주 경고래."
   ],
   "dtype": "auto"
  },
  {
   "id": "t10",
   "mode": "clone",
   "model": "Qwen/Qwen3-TTS-12Hz-0.6B-Base",
   "voice": "voices/dori",
   "seed": 619,
   "takes": 4,
   "texts": [
    "경고 글씨도 더 커진대."
