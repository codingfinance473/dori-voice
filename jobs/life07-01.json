   "dtype": "auto"
  },
  {
   "id": "t05",
   "mode": "clone",
   "model": "Qwen/Qwen3-TTS-12Hz-0.6B-Base",
   "voice": "voices/dori",
   "seed": 121,
   "takes": 4,
   "texts": [
