   ],
   "dtype": "auto"
  },
  {
   "id": "t06",
   "mode": "clone",
   "model": "Qwen/Qwen3-TTS-12Hz-0.6B-Base",
   "voice": "voices/dori",
   "seed": 122,
   "takes": 4,
   "texts": [
    "이십만 원까지래!"
