   "dtype": "auto"
  },
  {
   "id": "t09",
   "mode": "clone",
   "model": "Qwen/Qwen3-TTS-12Hz-0.6B-Base",
   "voice": "voices/dori",
   "seed": 125,
   "takes": 4,
   "texts": [
